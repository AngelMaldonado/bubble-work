# Copy to .env and change what you actually want different.
#
# Every value here already has the same default inside scripts/env.sh, so a fresh
# clone runs with no .env at all. Keep this file to what somebody would plausibly
# change — a settings file that restates every default stops being read.

# Where the server listens.
BUBBLE_HTTP=127.0.0.1:8090

# The PocketBase data directory: database, backups, file storage.
# Deliberately not under dist/ — that is a build output somebody will delete.
BUBBLE_DATA=./pb_data

# Where the markdown tree lives: one git repository per workspace. The artifact
# bodies are FILES — open it with your own git, it is a normal repository.
BUBBLE_REPOS=./repos

# Where `just build` writes the binary.
BUBBLE_BIN=./dist/bubble

# The tmux session `just dev` runs in and `just stop` kills.
BUBBLE_TMUX=bubble

# Dev only. `just dev` creates or updates this superuser on every start, so a
# fresh clone reaches the dashboard in one command and a changed password here
# takes effect on the next `just dev`. If it cannot, `just dev` refuses to start
# rather than serving something nobody can sign in to.
#
# The password must be at least 8 characters — PocketBase refuses anything less.
# Leave both blank to skip this and manage superusers with `just superuser`.
# This is a local-machine credential: it is never used against anything but the
# data directory above, and .env is gitignored.
BUBBLE_DEV_SUPERUSER_EMAIL=dev@bubble.local
BUBBLE_DEV_SUPERUSER_PASSWORD=devdevdevdev
